---
import Base from '../layouts/Base.astro';
import { site, whatsappLink, formatAddress, serviceAreas } from '../data/site.js';
import { withBase, absoluteUrl } from '../utils/url.js';

const mapEmbedSrc = `https://www.google.com/maps?q=${site.address.lat},${site.address.lng}&z=16&output=embed`;

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl(Astro.site, '/') },
      { '@type': 'ListItem', position: 2, name: 'Visit Us', item: absoluteUrl(Astro.site, '/contact/') },
    ],
  },
];
---

<Base
  title="Visit Us — directions, hours & contact"
  description={`Find Kasturi Ayurveda Hospital in ${site.address.locality}, Hyderabad. Directions, opening hours, phone and WhatsApp for piles, fistula and fissure treatment.`}
  schema={schema}
>
  <section class="contact-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={withBase('/')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Visit Us</span>
      </nav>
      <p class="eyebrow">Find us</p>
      <h1>Visit the hospital</h1>
      <p class="lede">In {site.address.locality}, easily reached from across east Hyderabad.</p>
    </div>
  </section>

  <section>
    <div class="wrap contact-grid">
      <div class="details">
        <div class="detail-block">
          <h4>Address</h4>
          <address>
            {formatAddress().split(', ').map((line) => <span>{line}</span>)}
          </address>
          <a class="btn btn-call directions-btn" href={site.address.directionsUrl} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M3 11l18-8-8 18-2-8-8-2Z" stroke-linejoin="round" stroke-linecap="round"/>
            </svg>
            Get directions
          </a>
        </div>

        <div class="detail-block">
          <h4>Phone &amp; WhatsApp</h4>
          <a class="phone-link tnum" href={`tel:${site.phone.primary}`}>{site.phone.primaryDisplay}</a>
          {site.phone.secondaryDisplay && (
            <a class="phone-link phone-link-sub tnum" href={`tel:${site.phone.secondary}`}>{site.phone.secondaryDisplay}</a>
          )}
          <a class="btn btn-whatsapp wa-btn" href={whatsappLink()} target="_blank" rel="noopener">Message on WhatsApp</a>
        </div>

        <div class="detail-block">
          <h4>Opening hours</h4>
          <table class="hours-table">
            <tbody>
              {site.hours.map((h) => (
                <tr class={h.open ? '' : 'is-closed'}>
                  <th scope="row">{h.day}</th>
                  <td class="tnum">{h.display}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="hours-note">Appointments are recommended. Walk-ins are seen when the doctor is free.</p>
        </div>

        <div class="detail-block">
          <h4>Areas we're close to</h4>
          <p class="areas">{serviceAreas.join(' · ')}</p>
        </div>
      </div>

      <div class="map-wrap">
        <iframe
          src={mapEmbedSrc}
          title={`Map showing ${site.name}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-hero { padding-block: clamp(28px, 4vw, 52px) clamp(20px, 3vw, 32px); }
  .crumbs { display: flex; gap: 8px; font-size: 0.85rem; color: var(--ink-muted); margin-bottom: 20px; }
  .crumbs a { color: var(--ink-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--forest); text-decoration: underline; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(28px, 5vw, 52px);
    align-items: start;
  }
  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; } }

  .details { display: flex; flex-direction: column; gap: 30px; }
  .detail-block h4 {
    font-size: 0.75rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 12px;
  }

  address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--ink);
    margin-bottom: 16px;
  }
  .directions-btn { width: fit-content; }

  .phone-link {
    display: block;
    font-family: var(--font-display);
    font-size: 1.7rem;
    color: var(--forest);
    text-decoration: none;
    line-height: 1.25;
  }
  .phone-link:hover { color: var(--turmeric-deep); }
  .phone-link-sub { font-size: 1.15rem; color: var(--ink-body); }
  .wa-btn { margin-top: 14px; width: fit-content; }

  .hours-table { width: 100%; max-width: 340px; border-collapse: collapse; font-size: 0.95rem; }
  .hours-table th { text-align: left; font-weight: 600; color: var(--ink); padding: 8px 12px 8px 0; border-bottom: 1px solid var(--line); }
  .hours-table td { padding: 8px 0; border-bottom: 1px solid var(--line); color: var(--ink-body); text-align: right; }
  .hours-table tr.is-closed td, .hours-table tr.is-closed th { color: var(--ink-muted); }
  .hours-note { font-size: 0.85rem; color: var(--ink-muted); margin-top: 12px; }

  .areas { font-size: 0.98rem; }

  .map-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    aspect-ratio: 4 / 3;
    background: var(--paper-sunk);
  }
  .map-wrap iframe { width: 100%; height: 100%; border: 0; }

  @media (max-width: 900px) { .map-wrap { aspect-ratio: 16 / 10; } }
</style>
