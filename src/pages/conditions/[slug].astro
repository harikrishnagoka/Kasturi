---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { site, whatsappLink } from '../../data/site.js';
import { conditions } from '../../data/conditions.js';
import { withBase, absoluteUrl } from '../../utils/url.js';

export function getStaticPaths() {
  return conditions.map((c) => ({ params: { slug: c.slug }, props: { condition: c } }));
}

const { condition: c } = Astro.props;
const others = conditions.filter((o) => o.slug !== c.slug);

const schema = [
  {
    '@type': 'MedicalWebPage',
    '@id': absoluteUrl(Astro.site, `/conditions/${c.slug}/#page`),
    name: c.title,
    about: {
      '@type': 'MedicalCondition',
      name: c.name,
      alternateName: [c.also, c.ayurvedicName],
      signOrSymptom: c.symptoms.map((s) => ({ '@type': 'MedicalSymptom', name: s })),
      possibleTreatment: { '@type': 'MedicalProcedure', name: c.treatment.lead },
    },
    audience: { '@type': 'PatientAudience' },
    lastReviewed: new Date().toISOString().slice(0, 10),
  },
  {
    '@type': 'FAQPage',
    '@id': absoluteUrl(Astro.site, `/conditions/${c.slug}/#faq`),
    mainEntity: c.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl(Astro.site, '/') },
      { '@type': 'ListItem', position: 2, name: c.name, item: absoluteUrl(Astro.site, `/conditions/${c.slug}/`) },
    ],
  },
];
---

<Base title={c.title} description={c.description} schema={schema} enquiryTopic={c.name.toLowerCase()}>
  <article>
    <!-- ============ HEADER ============ -->
    <section class="cond-hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={withBase('/')}>Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{c.name}</span>
        </nav>

        <p class="cond-te te">{c.nameTe}</p>
        <h1>{c.name} <span class="cond-also">({c.also})</span></h1>
        <p class="cond-sanskrit">Known in Ayurveda as <em>{c.ayurvedicName}</em></p>
        <p class="lede">{c.summary}</p>

        <div class="row gap-sm cond-actions">
          <a class="btn btn-call" href={`tel:${site.phone.primary}`}>Call {site.phone.primaryDisplay}</a>
          <a
            class="btn btn-whatsapp"
            href={whatsappLink(`Hello, I'd like to ask about ${c.name.toLowerCase()} treatment at Kasturi Ayurveda Hospital.`)}
            target="_blank"
            rel="noopener"
          >Ask on WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- ============ SYMPTOMS / CAUSES ============ -->
    <section class="section-sunk">
      <div class="wrap grid grid-2 sc-grid">
        <div class="card">
          <h2>Signs you might have {c.name.toLowerCase()}</h2>
          <ul class="tick-list">
            {c.symptoms.map((s) => (
              <li>
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{s}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="card">
          <h2>What causes it</h2>
          <ul class="dot-list">
            {c.causes.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ STAGES ============ -->
    <section>
      <div class="wrap">
        <p class="eyebrow">How far along is it?</p>
        <h2>Stages of {c.name.toLowerCase()}</h2>
        <p class="lede">
          The stage matters, because it decides whether medicines alone will do or whether a
          procedure is needed. This is what the examination establishes.
        </p>
        <div class="stages">
          {c.stages.map((s, i) => (
            <div class="stage reveal">
              <span class="stage-index tnum" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h4>{s.grade}</h4>
                <p>{s.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ TREATMENT ============ -->
    <section class="section-forest">
      <div class="wrap wrap-narrow">
        <p class="eyebrow">How we treat it</p>
        <h2>{c.treatment.lead}</h2>
        <p class="lede">{c.treatment.body}</p>
        <a class="btn btn-whatsapp" href={withBase('/kshara-sutra/')}>Read about Kshara Sutra →</a>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section>
      <div class="wrap wrap-narrow">
        <Faq items={c.faqs} heading={`${c.name} — your questions`} />
      </div>
    </section>

    <!-- ============ CROSS-LINKS ============ -->
    <section class="section-sunk">
      <div class="wrap">
        <h2>Not sure this is the right one?</h2>
        <p class="lede">These three are commonly mistaken for each other, and they can occur together.</p>
        <div class="grid grid-2 other-grid">
          {others.map((o) => (
            <a class="other-card" href={withBase(`/conditions/${o.slug}/`)}>
              <span class="te other-te">{o.nameTe}</span>
              <strong>{o.name}</strong>
              <span class="other-sum">{o.summary}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  .cond-hero { padding-block: clamp(28px, 4vw, 52px) clamp(32px, 5vw, 56px); }

  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin-bottom: 20px;
  }
  .crumbs a { color: var(--ink-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--forest); text-decoration: underline; }

  .cond-te {
    font-family: var(--font-te);
    font-size: 1.35rem;
    color: var(--turmeric-deep);
    margin: 0 0 4px;
  }
  .cond-hero h1 { margin-bottom: 0.15em; }
  .cond-also {
    font-size: 0.5em;
    color: var(--ink-muted);
    font-weight: 400;
    white-space: nowrap;
  }
  .cond-sanskrit {
    font-size: 0.92rem;
    color: var(--ink-muted);
    margin-bottom: 1.1em;
  }
  .cond-sanskrit em { color: var(--forest); font-weight: 600; font-style: italic; }
  .cond-actions { margin-top: 26px; }

  .sc-grid { align-items: start; }
  .sc-grid h2 { font-size: 1.35rem; margin-bottom: 0.7em; }

  .tick-list, .dot-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .tick-list li { display: flex; gap: 11px; align-items: flex-start; }
  .tick-list svg { flex: none; margin-top: 4px; color: var(--positive); }

  .dot-list li { position: relative; padding-left: 20px; }
  .dot-list li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--turmeric);
  }

  .stages { display: flex; flex-direction: column; margin-top: 28px; }
  .stage {
    display: flex;
    gap: 18px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .stage:last-child { border-bottom: 1px solid var(--line); }
  .stage-index {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--turmeric);
    flex: none;
    width: 2em;
    padding-top: 2px;
  }
  .stage h4 { margin: 0 0 3px; }
  .stage p { margin: 0; color: var(--ink-muted); font-size: 0.95rem; }

  .other-grid { margin-top: 26px; }
  .other-card {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 22px;
    text-decoration: none;
    color: var(--ink-body);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .other-card:hover { border-color: var(--turmeric); transform: translateY(-2px); color: var(--ink-body); }
  .other-te { color: var(--turmeric-deep); font-size: 0.95rem; }
  .other-card strong { font-family: var(--font-display); font-size: 1.3rem; font-weight: 500; color: var(--ink); }
  .other-sum { font-size: 0.9rem; color: var(--ink-muted); }

  @media (prefers-reduced-motion: reduce) {
    .other-card, .other-card:hover { transition: none; transform: none; }
  }
</style>
