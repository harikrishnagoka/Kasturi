---
import Base from '../layouts/Base.astro';
import SymptomFinder from '../components/SymptomFinder.astro';
import Faq from '../components/Faq.astro';
import { Image } from 'astro:assets';
import { site, whatsappLink, serviceAreas } from '../data/site.js';
import { conditions } from '../data/conditions.js';
import { withBase, absoluteUrl } from '../utils/url.js';

import exterior from '../assets/jd_ooj1syhDJI-250.jpg';
import reception from '../assets/jd_XO2WOCAThi-250.jpg';
import waiting from '../assets/jd_uBQcT1GDld-250.jpg';
import theatre from '../assets/jd_N1PLhTsxIT-250.jpg';

const homeFaqs = [
  {
    q: 'Where is the hospital?',
    a: `We are in ${site.address.locality}, east Hyderabad — easily reached from Boduppal, Uppal, Peerzadiguda and Ghatkesar. Call ${site.phone.primaryDisplay} and we will guide you in.`,
  },
  {
    q: 'Do I need an appointment?',
    a: 'An appointment is better, because it means you are seen at a fixed time and do not sit in a waiting room longer than necessary. Walk-ins are seen when the doctor is free. Call or send a WhatsApp message to fix a time.',
  },
  {
    q: 'Is Kshara Sutra actually proven, or is it traditional medicine?',
    a: 'Both. It is a classical Ayurvedic para-surgical technique described by Sushruta, and it has also been studied in modern clinical settings — it is recognised and practised in government Ayurvedic hospitals across India for fistula-in-ano specifically because of its low recurrence rate and its sparing of the sphincter muscle.',
  },
  {
    q: 'Will anyone know I came here?',
    a: 'No. Consultations are private and what you discuss stays between you and the doctor. Many patients delay treatment for months out of embarrassment, and the condition almost always gets harder to treat in that time.',
  },
  {
    q: 'What should I bring to the first visit?',
    a: 'Any previous prescriptions, operation notes or scan reports if you have them. If you have been treated elsewhere for the same problem, those records are genuinely useful.',
  },
];

const schema = [
  {
    '@type': 'FAQPage',
    '@id': absoluteUrl(Astro.site, '/#faq'),
    mainEntity: homeFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title={`Piles, Fistula & Fissure Treatment in Medipally, Hyderabad`}
  description={`Specialist Ayurvedic piles, fistula and fissure treatment in Medipally, Hyderabad. Kshara Sutra by Dr. Venkanna Kasturi, MS (Ayurveda). 5.0★ on Google. Call ${site.phone.primaryDisplay}.`}
  schema={schema}
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">
          <span class="te">కస్తూరి ఆయుర్వేద హాస్పిటల్</span>
          <span class="dot" aria-hidden="true">·</span>
          <span>{site.address.locality}, Hyderabad</span>
        </p>

        <h1>Piles, fistula and fissure — treated without major surgery.</h1>

        <p class="lede">
          A specialist Ayurvedic centre for one set of problems, done properly. Dr. Venkanna Kasturi
          uses <strong>Kshara Sutra</strong>, a thread-based procedure that treats the problem along its
          full length while sparing the muscle that keeps you continent. Day procedure. Local anaesthesia.
          Home the same day.
        </p>

        <div class="row gap-sm hero-actions">
          <a class="btn btn-call" href={`tel:${site.phone.primary}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {site.phone.primaryDisplay}
          </a>
          <a class="btn btn-whatsapp" href={whatsappLink()} target="_blank" rel="noopener">
            Ask on WhatsApp
          </a>
        </div>

        <ul class="trust-row">
          <li>
            <strong class="tnum">{site.rating.value}★</strong>
            <span>on Google · {site.rating.count} reviews</span>
          </li>
          <li>
            <strong class="tnum">{site.heritage.generations}</strong>
            <span>generations of Ayurvedic practice</span>
          </li>
          <li>
            <strong>MS</strong>
            <span>(Ayurveda) · specialist practice</span>
          </li>
        </ul>
      </div>

      <div class="hero-media">
        <Image
          src={exterior}
          alt={`The entrance to ${site.name} in ${site.address.locality}, Hyderabad`}
          widths={[360, 720]}
          sizes="(max-width: 900px) 100vw, 420px"
          loading="eager"
          fetchpriority="high"
        />
        <p class="hero-media-cap">Our entrance on Road No. 2, {site.address.locality}</p>
      </div>
    </div>
  </section>

  <!-- ============ REASSURANCE STRIP ============ -->
  <section class="strip section-forest">
    <div class="wrap strip-inner">
      <p>
        Most people wait months before coming in, because it is an embarrassing thing to talk about.
        <strong>It is the waiting that makes it harder to treat</strong> — not the condition itself.
      </p>
    </div>
  </section>

  <!-- ============ SYMPTOM FINDER ============ -->
  <section>
    <div class="wrap">
      <SymptomFinder />
    </div>
  </section>

  <!-- ============ CONDITIONS ============ -->
  <section class="section-sunk">
    <div class="wrap">
      <p class="eyebrow">What we treat</p>
      <h2>Three conditions, treated by someone who treats them every day</h2>
      <p class="lede">
        A general hospital sees these occasionally. This centre was built for them.
      </p>

      <div class="grid grid-3 conditions-grid">
        {conditions.map((c) => (
          <a class="cond-card reveal" href={withBase(`/conditions/${c.slug}/`)}>
            <p class="cond-te te">{c.nameTe}</p>
            <h3>{c.name}</h3>
            <p class="cond-alt">{c.also} · <em>{c.ayurvedicName}</em></p>
            <p class="cond-sum">{c.summary}</p>
            <span class="cond-more">Read about {c.name.toLowerCase()} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ KSHARA SUTRA ============ -->
  <section>
    <div class="wrap ks-grid">
      <div>
        <p class="eyebrow">The treatment</p>
        <h2>What Kshara Sutra actually is</h2>
        <p class="lede">
          A medicated thread is passed through the fistula tract. Coated in herbal alkaline
          preparations, it does two things at once as it sits there: it slowly cuts through the
          tract, and it heals the tissue closing behind it.
        </p>
        <p>
          Because it works gradually along the same line rather than cutting tissue away, the
          sphincter muscle is preserved. That is the whole point, and it is why the technique is
          used in government Ayurvedic hospitals across India for fistula specifically.
        </p>
        <a class="btn btn-ghost" href={withBase('/kshara-sutra/')}>How the procedure works, step by step</a>
      </div>

      <ol class="ks-steps">
        <li>
          <span class="ks-num">1</span>
          <div>
            <h4>Examination and assessment</h4>
            <p>The tract is examined to establish its length, depth and branches.</p>
          </div>
        </li>
        <li>
          <span class="ks-num">2</span>
          <div>
            <h4>The thread is placed</h4>
            <p>Done under local anaesthesia as a day procedure. You go home the same day.</p>
          </div>
        </li>
        <li>
          <span class="ks-num">3</span>
          <div>
            <h4>Weekly thread change</h4>
            <p>A short outpatient visit each week. Most patients keep working throughout.</p>
          </div>
        </li>
        <li>
          <span class="ks-num">4</span>
          <div>
            <h4>Healing and discharge</h4>
            <p>The tract closes progressively. Follow-up continues until it has healed fully.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ THE HOSPITAL ============ -->
  <section class="section-sunk">
    <div class="wrap">
      <p class="eyebrow">The hospital</p>
      <h2>A small, clean, purpose-built centre</h2>
      <p class="lede">
        Not a large hospital. A focused day-procedure centre where the doctor sees you himself,
        every visit.
      </p>

      <div class="gallery">
        <figure>
          <Image src={reception} alt="Reception and in-house pharmacy" widths={[300, 600]} sizes="(max-width: 700px) 50vw, 300px" loading="lazy" />
          <figcaption>Reception and in-house pharmacy</figcaption>
        </figure>
        <figure>
          <Image src={waiting} alt="Waiting area, with a painting of Sushruta" widths={[300, 600]} sizes="(max-width: 700px) 50vw, 300px" loading="lazy" />
          <figcaption>Waiting area</figcaption>
        </figure>
        <figure>
          <Image src={theatre} alt="The day-procedure room" widths={[300, 600]} sizes="(max-width: 700px) 50vw, 300px" loading="lazy" />
          <figcaption>Day-procedure room</figcaption>
        </figure>
      </div>

      <div class="sushruta card">
        <p class="eyebrow">Why there is a painting of Sushruta in our waiting room</p>
        <p>
          Sushruta, who lived and taught surgery in India around the 6th century BCE, is called the
          father of surgery — and he was an Ayurvedic physician. Kshara Sutra is described in his
          writings. When people ask whether they are choosing between "Ayurveda" and "surgery",
          the honest answer is that this technique has been surgical from the beginning.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ DOCTOR ============ -->
  <section>
    <div class="wrap doctor-grid">
      <div>
        <p class="eyebrow">Your doctor</p>
        <h2>{site.doctor.name}</h2>
        <p class="doctor-qual">{site.doctor.qualification}</p>
        <p class="lede">
          The Kasturi family have practised Ayurveda for four generations. Dr. Venkanna Kasturi
          carries that into a specialist practice, treating piles, fistula and fissure — and little
          else.
        </p>
        <p>
          Patients consistently mention two things in their reviews: that he explains the condition
          plainly, and that the medicines are not expensive. Both are deliberate.
        </p>
        <a class="btn btn-ghost" href={withBase('/about/')}>More about the doctor and the practice</a>
      </div>

      <blockquote class="quote card">
        <p>
          “This is the best hospital. I went here for the treatment of fissures — the doctor treats
          well, I got the best result. The doctor's communication is very good with patients. Now I
          am good and healthy.”
        </p>
        <footer>
          <span class="stars" aria-label="5 out of 5 stars">★★★★★</span>
          <cite>Google review</cite>
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- ============ VISIT ============ -->
  <section class="section-forest">
    <div class="wrap visit-grid">
      <div>
        <p class="eyebrow">Visit us</p>
        <h2>Come in and get it looked at</h2>
        <p class="lede">
          We are in {site.address.locality}, easily reached from {serviceAreas.slice(1, 5).join(', ')}
          and across east Hyderabad.
        </p>
        <div class="row gap-sm">
          <a class="btn btn-whatsapp" href={`tel:${site.phone.primary}`}>Call {site.phone.primaryDisplay}</a>
          <a class="btn btn-ghost btn-on-dark" href={withBase('/contact/')}>Directions &amp; hours</a>
        </div>
      </div>
      <div class="visit-hours">
        <h4>Opening hours</h4>
        <table class="hours-table">
          <tbody>
            {site.hours.map((h) => (
              <tr class={h.open ? '' : 'is-closed'}>
                <th scope="row">{h.short}</th>
                <td class="tnum">{h.display}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section>
    <div class="wrap wrap-narrow">
      <Faq items={homeFaqs} />
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { padding-block: clamp(36px, 6vw, 72px); }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
  }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-media { order: -1; }
  }

  .hero-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    color: var(--ink-muted);
    margin-bottom: 14px;
  }
  .hero-kicker .dot { color: var(--turmeric); }

  .hero h1 { margin-bottom: 0.45em; }
  .hero .lede strong { color: var(--ink); font-weight: 700; }

  .hero-actions { margin-top: 26px; }

  .trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 30px;
    list-style: none;
    margin: 30px 0 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--line);
  }
  .trust-row li { display: flex; align-items: baseline; gap: 8px; font-size: 0.88rem; color: var(--ink-muted); }
  .trust-row strong {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--forest);
    font-weight: 600;
    line-height: 1;
  }

  .hero-media img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .hero-media-cap {
    margin: 10px 0 0;
    font-size: 0.82rem;
    color: var(--ink-muted);
    text-align: center;
  }

  /* ---------- strip ---------- */
  .strip { padding-block: clamp(28px, 4vw, 44px); }
  .strip-inner p {
    max-width: 66ch;
    margin: 0 auto;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    line-height: 1.45;
    color: var(--ink-body);
  }
  .strip-inner strong { color: #F2C878; font-weight: 500; }

  /* ---------- conditions ---------- */
  .conditions-grid { margin-top: 32px; }

  .cond-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 26px 24px;
    text-decoration: none;
    color: var(--ink-body);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .cond-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--turmeric);
    color: var(--ink-body);
  }
  .cond-te { font-size: 1rem; color: var(--turmeric-deep); margin: 0; }
  .cond-card h3 { margin: 0 0 2px; }
  .cond-alt { font-size: 0.85rem; color: var(--ink-muted); margin: 0 0 12px; }
  .cond-alt em { font-style: italic; }
  .cond-sum { font-size: 0.95rem; margin-bottom: 16px; }
  .cond-more {
    margin-top: auto;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--forest);
  }
  .cond-card:hover .cond-more { color: var(--turmeric-deep); }

  /* ---------- kshara sutra ---------- */
  .ks-grid {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: clamp(28px, 5vw, 60px);
    align-items: start;
  }
  @media (max-width: 860px) { .ks-grid { grid-template-columns: 1fr; } }
  .ks-grid .btn-ghost { margin-top: 8px; }

  .ks-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    counter-reset: step;
  }
  .ks-steps li {
    display: flex;
    gap: 16px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .ks-steps li:last-child { border-bottom: 1px solid var(--line); }
  .ks-num {
    flex: none;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--forest-tint);
    color: var(--forest);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .ks-steps h4 { margin: 0 0 3px; }
  .ks-steps p { margin: 0; font-size: 0.93rem; color: var(--ink-muted); }

  /* ---------- gallery ---------- */
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin: 32px 0;
  }
  .gallery figure { margin: 0; }
  .gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .gallery figcaption {
    margin-top: 8px;
    font-size: 0.83rem;
    color: var(--ink-muted);
  }

  .sushruta { max-width: 74ch; }
  .sushruta p:last-child { margin: 0; }

  /* ---------- doctor ---------- */
  .doctor-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: start;
  }
  @media (max-width: 860px) { .doctor-grid { grid-template-columns: 1fr; } }

  .doctor-qual {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--turmeric-deep);
    font-weight: 700;
    margin-top: -0.6em;
  }
  .doctor-grid .btn-ghost { margin-top: 8px; }

  .quote {
    background: var(--forest-tint);
    border-color: transparent;
    margin: 0;
  }
  .quote p {
    font-family: var(--font-display);
    font-size: 1.12rem;
    line-height: 1.5;
    color: var(--ink);
  }
  .quote footer {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }
  .stars { color: var(--turmeric); letter-spacing: 0.1em; }
  .quote cite { font-style: normal; }

  /* ---------- visit ---------- */
  .visit-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
  }
  @media (max-width: 780px) { .visit-grid { grid-template-columns: 1fr; } }

  .btn-on-dark { color: var(--ink); border-color: rgba(255, 255, 255, 0.3); }
  .btn-on-dark:hover { border-color: #E3A63F; color: #E3A63F; }

  .visit-hours h4 {
    font-size: 0.75rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 10px;
  }
  .hours-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .hours-table th {
    text-align: left;
    font-weight: 600;
    color: var(--ink);
    padding: 8px 12px 8px 0;
    border-bottom: 1px solid var(--line);
    width: 4em;
  }
  .hours-table td {
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-body);
  }
  .hours-table tr.is-closed td, .hours-table tr.is-closed th { color: var(--ink-muted); }
</style>
