---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { site, whatsappLink } from '../data/site.js';
import { withBase, absoluteUrl } from '../utils/url.js';

const faqs = [
  {
    q: 'Is Kshara Sutra a surgery?',
    a: 'It is a para-surgical procedure — it achieves what surgery achieves, but gradually and without a large incision. It is performed under local anaesthesia as a day procedure.',
  },
  {
    q: 'How long will the whole treatment take?',
    a: 'The rule of thumb used in practice is roughly one week per centimetre of tract, so a short simple fistula may take four to six weeks and a longer or branching one considerably more. The doctor will give you a realistic estimate after examining you.',
  },
  {
    q: 'Why is it better than conventional fistula surgery?',
    a: 'For high or complex fistulas, conventional surgery risks cutting the sphincter muscle that controls continence. Kshara Sutra cuts and heals along the same line simultaneously, so the muscle knits back as the thread advances. It also has a notably low recurrence rate.',
  },
  {
    q: 'Does it hurt?',
    a: 'The placement is done under local anaesthesia. There is aching for a day or two afterwards, and some discomfort at each weekly change, both managed with medication. Most patients find it far more tolerable than they had feared.',
  },
  {
    q: 'Will I be able to work?',
    a: 'Most patients continue working throughout the treatment, coming in once a week for the thread change. Jobs involving long hours of riding or heavy lifting may need modification — discuss this at your first visit.',
  },
  {
    q: 'What is the thread actually made of?',
    a: 'A surgical linen or thread base, repeatedly coated in classical herbal alkaline preparations — typically Apamarga kshara, Snuhi latex and turmeric. The coating is what does the work.',
  },
];

const schema = [
  {
    '@type': 'MedicalProcedure',
    '@id': absoluteUrl(Astro.site, '/kshara-sutra/#procedure'),
    name: 'Kshara Sutra',
    alternateName: 'Medicated seton thread procedure',
    procedureType: 'https://schema.org/PercutaneousProcedure',
    bodyLocation: 'Anal region',
    howPerformed:
      'A medicated alkaline-coated thread is passed through the fistula tract under local anaesthesia and changed weekly, cutting and healing the tract simultaneously.',
    preparation: 'Day procedure under local anaesthesia. No general anaesthesia required.',
    followup: 'Weekly outpatient thread change until the tract has healed.',
  },
  {
    '@type': 'FAQPage',
    '@id': absoluteUrl(Astro.site, '/kshara-sutra/#faq'),
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const comparison = [
  { point: 'Anaesthesia', ks: 'Local', surgery: 'Usually spinal or general' },
  { point: 'Hospital stay', ks: 'Day procedure — home the same day', surgery: 'Often 1–3 days' },
  { point: 'Risk to continence', ks: 'Low — muscle is spared', surgery: 'Real risk in high or complex tracts' },
  { point: 'Recurrence', ks: 'Low', surgery: 'Higher, particularly in complex fistula' },
  { point: 'Time to full healing', ks: 'Several weeks, working throughout', surgery: 'Shorter, but with a recovery period off work' },
  { point: 'Follow-up', ks: 'Weekly thread change', surgery: 'Periodic wound review' },
];
---

<Base
  title="Kshara Sutra treatment in Hyderabad — how it works"
  description="Kshara Sutra, the Ayurvedic medicated-thread procedure for fistula-in-ano, at Kasturi Ayurveda Hospital, Medipally, Hyderabad. Local anaesthesia, day procedure, low recurrence."
  schema={schema}
  enquiryTopic="Kshara Sutra"
>
  <section class="ks-hero">
    <div class="wrap wrap-narrow">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={withBase('/')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Kshara Sutra</span>
      </nav>
      <p class="eyebrow">The procedure</p>
      <h1>Kshara Sutra</h1>
      <p class="lede">
        A medicated thread, changed once a week, that cuts through a fistula tract and heals it
        behind itself at the same time. It is the reason patients travel to this centre, and it is
        described in Sushruta's writings from around the 6th century BCE.
      </p>
    </div>
  </section>

  <!-- ============ THE THREAD ============ -->
  <section class="section-sunk">
    <div class="wrap thread-grid">
      <div>
        <p class="eyebrow">What makes it work</p>
        <h2>The coating is the treatment</h2>
        <p>
          The thread itself is ordinary surgical linen. What matters is what it is coated in: layer
          upon layer of classical alkaline herbal preparations, applied and dried repeatedly before
          use.
        </p>
        <ul class="ingredients">
          <li><strong>Apamarga kshara</strong><span>The alkaline agent — debrides the tract wall</span></li>
          <li><strong>Snuhi latex</strong><span>Carries the kshara and holds it against the tissue</span></li>
          <li><strong>Haridra (turmeric)</strong><span>Antiseptic, and supports healing behind the cut</span></li>
        </ul>
        <p class="thread-note">
          As the coating acts on the tract wall, the thread migrates outward a little each week.
          Tissue heals in the space it leaves. That simultaneous cut-and-heal is the entire principle.
        </p>
      </div>

      <figure class="thread-viz">
        <svg viewBox="0 0 240 300" role="img" aria-labelledby="viz-title">
          <title id="viz-title">Diagram: a medicated thread threaded through a fistula tract, migrating outward week by week as tissue heals behind it</title>
          <defs>
            <linearGradient id="tissue" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--forest-tint)" />
              <stop offset="100%" stop-color="var(--paper-sunk)" />
            </linearGradient>
          </defs>

          <rect x="20" y="20" width="200" height="260" rx="14" fill="url(#tissue)" stroke="var(--line)" />

          <!-- the tract -->
          <path d="M62 234 C 92 194, 128 176, 168 92" fill="none" stroke="var(--line-strong)" stroke-width="16" stroke-linecap="round" opacity="0.55" />

          <!-- healed portion -->
          <path d="M62 234 C 78 214, 94 200, 108 186" fill="none" stroke="var(--positive)" stroke-width="16" stroke-linecap="round" opacity="0.35" class="viz-healed" />

          <!-- the thread -->
          <path d="M62 234 C 92 194, 128 176, 168 92" fill="none" stroke="var(--turmeric)" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="7 5" class="viz-thread" />

          <circle cx="62" cy="234" r="6" fill="var(--forest)" />
          <circle cx="168" cy="92" r="6" fill="var(--forest)" />

          <text x="34" y="262" class="viz-label">External opening</text>
          <text x="120" y="72" class="viz-label">Internal opening</text>
          <text x="86" y="206" class="viz-label viz-label-good">healing</text>
        </svg>
        <figcaption>The thread sits along the whole tract. Tissue closes behind it as it advances.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ COMPARISON ============ -->
  <section>
    <div class="wrap">
      <p class="eyebrow">Making the choice</p>
      <h2>Kshara Sutra compared with conventional surgery</h2>
      <p class="lede">
        Conventional fistula surgery is a legitimate option and sometimes the right one. This is an
        honest comparison of the trade-offs, so you can ask better questions at your consultation.
      </p>

      <div class="scroll-x compare-wrap">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col">&nbsp;</th>
              <th scope="col" class="is-ks">Kshara Sutra</th>
              <th scope="col">Conventional fistulectomy</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <th scope="row">{row.point}</th>
                <td class="is-ks">{row.ks}</td>
                <td>{row.surgery}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ WHAT TO EXPECT ============ -->
  <section class="section-forest">
    <div class="wrap">
      <p class="eyebrow">What to expect</p>
      <h2>Your treatment, week by week</h2>
      <ol class="timeline">
        <li>
          <h4>First visit</h4>
          <p>Examination to map the tract. You will be told the likely duration and cost before anything is decided.</p>
        </li>
        <li>
          <h4>Day of the procedure</h4>
          <p>Local anaesthesia, thread placed, observation for a short while, then home. Bring someone with you if you can.</p>
        </li>
        <li>
          <h4>Weeks 1 onward</h4>
          <p>One short visit a week to change the thread. Sitz baths and medicines continue at home.</p>
        </li>
        <li>
          <h4>Healing</h4>
          <p>The thread falls away once the tract has been fully traversed. Follow-up continues until healing is confirmed.</p>
        </li>
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap wrap-narrow">
      <Faq items={faqs} heading="Kshara Sutra — your questions" />

      <div class="cta card">
        <h3>Bring your reports and let's look at it properly</h3>
        <p>
          If you have been treated for a fistula before and it has come back, bring the operation
          notes. It genuinely changes the plan.
        </p>
        <div class="row gap-sm">
          <a class="btn btn-call" href={`tel:${site.phone.primary}`}>Call {site.phone.primaryDisplay}</a>
          <a class="btn btn-whatsapp" href={whatsappLink("Hello, I'd like to ask about Kshara Sutra treatment.")} target="_blank" rel="noopener">Ask on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .ks-hero { padding-block: clamp(28px, 4vw, 52px) clamp(24px, 4vw, 44px); }
  .crumbs { display: flex; gap: 8px; font-size: 0.85rem; color: var(--ink-muted); margin-bottom: 20px; }
  .crumbs a { color: var(--ink-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--forest); text-decoration: underline; }

  .thread-grid {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
  }
  @media (max-width: 860px) { .thread-grid { grid-template-columns: 1fr; } }

  .ingredients { list-style: none; margin: 22px 0; padding: 0; display: flex; flex-direction: column; }
  .ingredients li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 13px 0;
    border-top: 1px solid var(--line);
  }
  .ingredients li:last-child { border-bottom: 1px solid var(--line); }
  .ingredients strong { color: var(--forest); font-size: 1rem; }
  .ingredients span { font-size: 0.9rem; color: var(--ink-muted); }

  .thread-note { font-size: 0.95rem; color: var(--ink-muted); margin: 0; }

  .thread-viz { margin: 0; }
  .thread-viz svg { width: 100%; height: auto; }
  .viz-label {
    font-family: var(--font-body);
    font-size: 9px;
    fill: var(--ink-muted);
    letter-spacing: 0.04em;
  }
  .viz-label-good { fill: var(--positive); font-style: italic; }
  .thread-viz figcaption {
    margin-top: 10px;
    font-size: 0.84rem;
    color: var(--ink-muted);
    text-align: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .viz-thread {
      stroke-dashoffset: 96;
      animation: crawl 4s linear infinite;
    }
    @keyframes crawl { to { stroke-dashoffset: 0; } }
  }

  .compare-wrap { margin-top: 28px; border: 1px solid var(--line); border-radius: var(--radius-lg); }
  .compare {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    min-width: 560px;
    background: var(--paper-raised);
  }
  .compare th, .compare td { padding: 14px 16px; text-align: left; vertical-align: top; }
  .compare thead th {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border-bottom: 1.5px solid var(--line-strong);
  }
  .compare tbody th {
    font-weight: 600;
    color: var(--ink);
    width: 11em;
    border-bottom: 1px solid var(--line);
  }
  .compare tbody td { border-bottom: 1px solid var(--line); color: var(--ink-body); }
  .compare tbody tr:last-child th, .compare tbody tr:last-child td { border-bottom: 0; }
  .compare .is-ks { background: var(--forest-tint); }
  .compare thead .is-ks { color: var(--forest); font-weight: 700; }

  .timeline {
    list-style: none;
    counter-reset: t;
    margin: 30px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 20px;
  }
  .timeline li {
    counter-increment: t;
    padding-top: 18px;
    border-top: 2px solid rgba(255, 255, 255, 0.2);
    position: relative;
  }
  .timeline li::before {
    content: counter(t);
    position: absolute;
    top: -13px;
    left: 0;
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #E3A63F;
    color: #23180A;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .timeline h4 { margin: 6px 0 5px; }
  .timeline p { margin: 0; font-size: 0.92rem; color: var(--ink-muted); }

  .cta { margin-top: 44px; background: var(--forest-tint); border-color: transparent; }
  .cta h3 { margin-bottom: 0.4em; }
</style>
