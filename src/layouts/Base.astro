---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import { site, formatAddress } from '../data/site.js';
import { withBase } from '../utils/url.js';

const {
  title,
  description,
  /** Extra JSON-LD nodes (e.g. FAQPage, MedicalWebPage) merged into the graph. */
  schema = [],
  /** Set on condition pages so the action bar can pre-fill the WhatsApp message. */
  enquiryTopic = null,
} = Astro.props;

// Astro.url.pathname omits the trailing slash for the base-root page
// specifically (e.g. "/Kasturi" instead of "/Kasturi/") — normalise it so
// every canonical URL, including the homepage, ends the same way.
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, Astro.site).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

// Resolve absolute URLs against wherever this build is actually deployed
// (Astro.site), NOT the aspirational production domain in data/site.js —
// that domain doesn't host anything yet. Once a real domain is attached,
// updating `site`/`base` in astro.config.mjs is the only change needed;
// everything below follows automatically.
const origin = Astro.site.origin;
const absolute = (path) => `${origin}${withBase(path)}`;

const a = site.address;

// Core local-SEO graph. MedicalClinic is the most accurate schema.org type for
// a specialist Ayurvedic day-procedure centre.
const organisation = {
  '@type': ['MedicalClinic', 'LocalBusiness'],
  '@id': absolute('/#organisation'),
  name: site.name,
  alternateName: site.nameTe,
  description: `Specialist Ayurvedic Piles, Fistula and Fissure cure centre in ${a.locality}, ${a.city}. Kshara Sutra treatment by ${site.doctor.name}, ${site.doctor.qualification}.`,
  url: absolute('/'),
  telephone: site.phone.primary,
  image: absolute('/brand/logo-lockup.png'),
  logo: absolute('/brand/icon-512.png'),
  priceRange: '₹₹',
  medicalSpecialty: 'Proctology',
  address: {
    '@type': 'PostalAddress',
    streetAddress: a.street,
    addressLocality: a.locality,
    addressRegion: a.region,
    postalCode: a.postalCode,
    addressCountry: a.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: a.lat, longitude: a.lng },
  hasMap: a.mapsUrl,
  openingHoursSpecification: site.hours
    .filter((h) => h.open)
    .map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: `https://schema.org/${h.day}`,
      opens: h.open,
      closes: h.close,
    })),
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.rating.value,
    reviewCount: site.rating.count,
    bestRating: '5',
  },
  availableService: [
    'Kshara Sutra',
    'Piles treatment',
    'Fistula treatment',
    'Anal fissure treatment',
    'Skin tag removal',
  ].map((s) => ({ '@type': 'MedicalProcedure', name: s })),
  employee: {
    '@type': 'Physician',
    '@id': absolute('/about/#doctor'),
    name: site.doctor.name,
    honorificPrefix: 'Dr.',
    medicalSpecialty: 'Proctology',
    knowsAbout: ['Kshara Sutra', 'Ayurvedic proctology', 'Piles', 'Fistula-in-ano', 'Anal fissure'],
  },
};

const graph = [
  organisation,
  {
    '@type': 'WebSite',
    '@id': absolute('/#website'),
    url: absolute('/'),
    name: site.name,
    publisher: { '@id': absolute('/#organisation') },
    inLanguage: 'en-IN',
  },
  ...schema,
];

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href={withBase('/brand/icon-32.png')} sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/brand/icon-180.png')} />
    <meta name="theme-color" content="#284840" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute('/brand/logo-lockup.png')} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="geo.region" content="IN-TG" />
    <meta name="geo.placename" content={`${a.locality}, ${a.city}`} />
    <meta name="geo.position" content={`${a.lat};${a.lng}`} />
    <meta name="ICBM" content={`${a.lat}, ${a.lng}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Karla:wght@400;500;600;700&family=Noto+Sans+Telugu:wght@400;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ActionBar topic={enquiryTopic} />

    <script>
      // Reveal-on-scroll. Held behind the reduced-motion check so the CSS
      // transition never runs for people who have asked for less movement.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll('.reveal');
      if (reduced || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
