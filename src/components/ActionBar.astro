---
import { site, whatsappLink } from '../data/site.js';

const { topic } = Astro.props;
const message = topic
  ? `Hello, I'd like to ask about ${topic} treatment at Kasturi Ayurveda Hospital.`
  : undefined;
---

<!--
  Fixed on mobile only. Patients arriving here are usually in pain and on a
  phone, so the two things that actually convert — a call and a WhatsApp
  message — stay within thumb reach at all times.
-->
<div class="action-bar">
  <a class="btn btn-call" href={`tel:${site.phone.primary}`} data-analytics="call-bar">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    Call the hospital
  </a>
  <a class="btn btn-whatsapp" href={whatsappLink(message)} target="_blank" rel="noopener" data-analytics="whatsapp-bar">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20Zm4.4-5.8c-.2-.1-1.4-.7-1.7-.8s-.4-.1-.5.1-.6.8-.8 1-.3.2-.5 0a6.5 6.5 0 0 1-1.9-1.2 7.3 7.3 0 0 1-1.4-1.7c-.1-.3 0-.4.1-.5l.4-.5.2-.4v-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3A3 3 0 0 0 7 9.9a5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4 5.3 5.3 0 0 0 2.4.5 2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/>
    </svg>
    WhatsApp
  </a>
</div>

<style>
  .action-bar { display: none; }

  @media (max-width: 820px) {
    :root { --actionbar-h: 76px; }
    .action-bar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 70;
      padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
      background: color-mix(in srgb, var(--paper) 92%, transparent);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--line);
    }
    .action-bar .btn {
      min-height: 52px;
      font-size: 0.95rem;
      padding-inline: 0.6em;
    }
  }
</style>

<script>
  // The mobile bar is fixed, so the body needs matching bottom padding. The
  // custom property is set on :root by the media query above; this keeps the
  // value in sync if the viewport is resized across the breakpoint.
  const sync = () => {
    const on = window.matchMedia('(max-width: 820px)').matches;
    document.documentElement.style.setProperty('--actionbar-h', on ? '76px' : '0px');
  };
  sync();
  window.addEventListener('resize', sync);
</script>
